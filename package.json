{
  "name": "saathi-server",
  "version": "0.1.0",
  "private": true,
  "description": "Backend for Saathi: diet/routine companion app with a dietitian marketplace",
  "main": "dist/index.js",
  "engines": {
    "node": "22.x",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "seed": "node dist/seed.js",
    "seed:dev": "tsx src/seed.ts",
    "mail:check": "tsx scripts/check-mail.ts",
    "mail:preview": "tsx scripts/preview-email.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1178.0",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "firebase-admin": "^14.5.1",
    "google-auth-library": "^11.3.4",
    "helmet": "^8.0.0",
    "jose": "^6.2.18",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "nodemailer": "^6.9.16",
    "twilio": "^6.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
