# --- Core ---
NODE_ENV=development
PORT=3000
# Heroku: set to your Atlas connection string (required in production)
MONGODB_URI=mongodb://127.0.0.1:27017/saathi

# --- Secrets (required in production, >= 32 chars each) ---
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
OTP_PEPPER=change-me-otp-pepper-at-least-32-characters

# --- Token lifetimes ---
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Access control ---
# Comma separated; these emails get the admin role on sign-in
ADMIN_EMAILS=
# Comma separated browser origins allowed by CORS (the Android app does not need CORS). Empty = CORS disabled.
CORS_ORIGINS=

# --- App links ---
# Base used for partner invite links, e.g. https://saathi.app
APP_LINK_BASE=https://saathi.example

# --- Config cache ---
CONFIG_CACHE_TTL_SECONDS=60

# --- Providers ---
# Stub providers (console mailer, stub SMS, stub Google/Apple verifiers, stub Play billing, stub AI reader)
# are ALWAYS used outside production. In production they are refused unless this is "true".
ALLOW_STUB_PROVIDERS=false
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_ID=
PLAY_PACKAGE_NAME=com.saathi.app
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Mail (required in production): Resend API key + a verified sender
RESEND_API_KEY=
MAIL_FROM=Saathi <no-reply@yourdomain.com>
# Or any SMTP server (Gmail: smtp.gmail.com, 465, an app password)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# PRIVATE STAGING ONLY, until a mailer is set up: prints sign-in codes in the logs
LOG_OTP=false
ANTHROPIC_API_KEY=
