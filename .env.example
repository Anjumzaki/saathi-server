# --- Core ---
NODE_ENV=development
PORT=3000
# Heroku: set to your Atlas connection string (required in production)
MONGODB_URI=mongodb://127.0.0.1:27017/saathi

# --- Secrets (required in production, >= 32 chars each) ---
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
OTP_PEPPER=change-me-otp-pepper-at-least-32-characters

# --- Token lifetimes ---
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=30

# --- Access control ---
# Comma separated; these emails get the admin role on sign-in
ADMIN_EMAILS=
# Comma separated browser origins allowed by CORS (the Android app does not need CORS). Empty = CORS disabled.
CORS_ORIGINS=

# --- App links ---
# Base used for partner invite links, e.g. https://saathi.app
APP_LINK_BASE=https://saathi-app.com
# Main website address; in production, pages opened on another host (the herokuapp.com one) redirect here.
# SITE_HOST=www.saathi-app.com

# --- Config cache ---
CONFIG_CACHE_TTL_SECONDS=60

# --- Providers ---
# Stub providers (console mailer, stub SMS, stub Google/Apple verifiers, stub Play billing, stub AI reader)
# are ALWAYS used outside production. In production they are refused unless this is "true".
ALLOW_STUB_PROVIDERS=false
# Both the web and the iOS client: a Google token's audience differs per platform.
GOOGLE_CLIENT_IDS=474789309476-p1l9k1hk5vq733qk57lo2qdbn2entrae.apps.googleusercontent.com,474789309476-lb9ujihmki9j7cjmp8534gnpvacov08m.apps.googleusercontent.com
APPLE_CLIENT_ID=com.multiware.saathi
PLAY_PACKAGE_NAME=com.multiware.saathi
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Mail (required in production). SMTP wins when SMTP_HOST/USER/PASS are all set,
# otherwise RESEND_API_KEY is used. MAIL_FROM must be the same address as SMTP_USER.
# GoDaddy Professional Email (Titan). Username = full address, password = the MAILBOX
# password (not the GoDaddy account password). Verify with: npm run mail:check -- you@example.com
# NOTE (2026-11-12): CONFIRMED WORKING from Heroku: 465, implicit TLS, 250 accepted.
# It does NOT work from a Pakistan residential IP: smtpout.secureserver.net returns a banner
# then resets the socket before AUTH, on both 465 and 587. So `npm run mail:check` will fail
# locally even when production is healthy -- test from a one-off dyno instead (see README).
# Titan's own relay smtp.titan.email returns 535: a GoDaddy-provisioned mailbox is not there.
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=support@saathi-app.com
SMTP_PASS=
MAIL_FROM=Saathi <support@saathi-app.com>
# Transactional alternative, better deliverability and limits for launch:
RESEND_API_KEY=
# PRIVATE STAGING ONLY, until a mailer is set up: prints sign-in codes in the logs
LOG_OTP=false
# Either key switches on both AI features (reading a plan, and writing one). OpenAI wins if both are set.
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
